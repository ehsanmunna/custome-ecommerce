# Runtime identity used by the API. It can read and write rows but cannot change schema.
DATABASE_URL=postgresql://app_runtime:app_runtime_password@localhost:5432/app

# Migration identity used only by migration and status commands. Never give this to the API process.
MIGRATION_DATABASE_URL=postgresql://app_migrator:app_migrator_password@localhost:5432/app

# Required API configuration. Every value below is validated at startup; none has a fallback.
NODE_ENV=development
PORT=3000
DATABASE_PROBE_TIMEOUT_MS=2000
LOG_LEVEL=info
