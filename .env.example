# Runtime identity used by the API. It can read and write rows but cannot change schema.
DATABASE_URL=postgresql://app_runtime:app_runtime_password@localhost:5432/app

# Migration identity used only by migration and status commands. Never give this to the API process.
MIGRATION_DATABASE_URL=postgresql://app_migrator:app_migrator_password@localhost:5432/app

# Required API configuration. Every value below is validated at startup; none has a fallback.
NODE_ENV=development
PORT=3000
DATABASE_PROBE_TIMEOUT_MS=2000
LOG_LEVEL=info

# Optional auth limits use validated defaults. Configure distinct random secrets in production.
# Development/test generate ephemeral secrets when these are omitted; existing sessions will not
# survive an API restart in those environments.
# AUTH_TOKEN_SIGNING_SECRET=
# AUTH_TOKEN_HASH_SECRET=
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# AUTH_OTP_TTL_SECONDS=300
# AUTH_OTP_MAX_ATTEMPTS=5
# AUTH_OTP_RATE_LIMIT_COUNT=5
# AUTH_OTP_RATE_LIMIT_WINDOW_SECONDS=3600

# Customer OTP delivery providers are optional and configured independently. Supply complete
# provider groups only through the deployment secret manager; never commit real credentials.
# Resend requires both values and a verified sender domain/address:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# Twilio requires all three values and a provisioned sender number:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Cloudflare R2 for the client's own account. All five storage values are required together for
# media operations; when they are absent the API still starts and media routes return 503.
# R2_PUBLIC_BASE_URL is the public custom domain or r2.dev URL used for delivery and resizing.
# Never commit real credentials; supply them through the client's secret manager.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=

# Presigned PUT lifetime and direct-upload size limit. These defaults are validated at startup.
R2_UPLOAD_TTL_SECONDS=600
R2_MAX_UPLOAD_BYTES=10485760
R2_IMAGE_RESIZING_ENABLED=true

# Steadfast courier integration. Configured per client through their secret manager.
# STEADFAST_API_KEY=
# STEADFAST_API_BASE_URL=https://api.steadfast.com.bd
# STEADFAST_WEBHOOK_SECRET=
