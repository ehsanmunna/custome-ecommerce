# Runtime identity used by the API. It can read and write rows but cannot change schema.
DATABASE_URL=postgresql://app_runtime:app_runtime_password@localhost:5432/app

# Migration identity used only by migration and status commands. Never give this to the API process.
MIGRATION_DATABASE_URL=postgresql://app_migrator:app_migrator_password@localhost:5432/app

# Required API configuration. Every value below is validated at startup; none has a fallback.
NODE_ENV=development
PORT=3000
DATABASE_PROBE_TIMEOUT_MS=2000
LOG_LEVEL=info

# Optional auth limits use validated defaults. Configure distinct random secrets in production.
# Development/test generate ephemeral secrets when these are omitted; existing sessions will not
# survive an API restart in those environments.
# AUTH_TOKEN_SIGNING_SECRET=
# AUTH_TOKEN_HASH_SECRET=
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# AUTH_OTP_TTL_SECONDS=300
# AUTH_OTP_MAX_ATTEMPTS=5
# AUTH_OTP_RATE_LIMIT_COUNT=5
# AUTH_OTP_RATE_LIMIT_WINDOW_SECONDS=3600

# OTP requests return 503 until an SMS/email delivery adapter is configured.
