enum ContentLocale {
  bn
  en
}

enum CategoryStatus {
  active
  archived
}

enum BrandStatus {
  active
  archived
}

enum ProductStatus {
  draft
  active
  archived
}

enum VariantStatus {
  active
  archived
}

enum AttributeValueType {
  text
  number
  boolean
  select
}

enum MediaProvider {
  r2
}

model Category {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId             String?               @map("parent_id") @db.Uuid
  parent               Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children             Category[]            @relation("CategoryTree")
  imageMediaId         String?               @map("image_media_id") @db.Uuid
  imageMedia           MediaAsset?           @relation("CategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  status               CategoryStatus        @default(active)
  sortOrder            Int                   @default(0) @map("sort_order")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations         CategoryTranslation[]
  products             Product[]
  attributeDefinitions AttributeDefinition[]

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model CategoryTranslation {
  categoryId      String        @map("category_id") @db.Uuid
  locale          ContentLocale
  name            String
  slug            String
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

model Brand {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageMediaId String?            @map("image_media_id") @db.Uuid
  imageMedia   MediaAsset?        @relation("BrandImage", fields: [imageMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  status       BrandStatus        @default(active)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations BrandTranslation[]
  products     Product[]

  @@index([status])
  @@map("brands")
}

model BrandTranslation {
  brandId         String        @map("brand_id") @db.Uuid
  locale          ContentLocale
  name            String
  slug            String
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  brand           Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([brandId, locale])
  @@unique([locale, slug])
  @@map("brand_translations")
}

model Product {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String               @map("category_id") @db.Uuid
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brandId      String?              @map("brand_id") @db.Uuid
  brand        Brand?               @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status       ProductStatus        @default(draft)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations ProductTranslation[]
  variants     ProductVariant[]
  media        ProductMedia[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductTranslation {
  productId        String        @map("product_id") @db.Uuid
  locale           ContentLocale
  name             String
  slug             String
  shortDescription String?       @map("short_description")
  description      String?
  metaTitle        String?       @map("meta_title")
  metaDescription  String?       @map("meta_description")
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([productId, locale])
  @@unique([locale, slug])
  @@map("product_translations")
}

model AttributeDefinition {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String             @map("category_id") @db.Uuid
  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attributeKey String             @map("attribute_key")
  valueType    AttributeValueType @map("value_type")
  isRequired   Boolean            @default(false) @map("is_required")
  isFilterable Boolean            @default(false) @map("is_filterable")
  options      String[]           @default([])
  sortOrder    Int                @default(0) @map("sort_order")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([categoryId, attributeKey])
  @@map("attribute_definitions")
}

model ProductVariant {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId            String         @map("product_id") @db.Uuid
  product              Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sku                  String         @unique
  pricePoisha          Int            @map("price_poisha")
  compareAtPricePoisha Int?           @map("compare_at_price_poisha")
  attributes           Json           @default("{}") @db.JsonB
  status               VariantStatus  @default(active)
  sortOrder            Int            @default(0) @map("sort_order")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  inventoryItem        InventoryItem?
  cartItems            CartItem[]
  orderItems           OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model MediaAsset {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider       MediaProvider  @default(r2)
  storageKey     String         @map("storage_key")
  mimeType       String         @map("mime_type")
  sizeBytes      BigInt         @map("size_bytes")
  width          Int?
  height         Int?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  altTexts       MediaAltText[]
  productMedia   ProductMedia[]
  categoryImages Category[]     @relation("CategoryImage")
  brandImages    Brand[]        @relation("BrandImage")

  @@unique([provider, storageKey])
  @@map("media_assets")
}

model MediaAltText {
  mediaId String        @map("media_id") @db.Uuid
  locale  ContentLocale
  altText String        @map("alt_text")
  media   MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([mediaId, locale])
  @@map("media_alt_texts")
}

model ProductMedia {
  productId String     @map("product_id") @db.Uuid
  mediaId   String     @map("media_id") @db.Uuid
  sortOrder Int        @default(0) @map("sort_order")
  isPrimary Boolean    @default(false) @map("is_primary")
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([productId, mediaId])
  @@index([mediaId])
  @@map("product_media")
}
