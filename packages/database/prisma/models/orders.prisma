enum CartStatus {
  active
  converted
  abandoned
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned
  partially_delivered
}

enum OrderReturnStatus {
  requested
  approved
  rejected
  received
  refunded
  cancelled
}

model Cart {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String?    @map("customer_id") @db.Uuid
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  status     CartStatus @default(active)
  expiresAt  DateTime?  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items      CartItem[]
  order      Order?

  @@index([customerId])
  @@index([status])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber            String               @unique @map("order_number")
  customerId             String?              @map("customer_id") @db.Uuid
  customer               Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cartId                 String?              @unique @map("cart_id") @db.Uuid
  cart                   Cart?                @relation(fields: [cartId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contactName            String               @map("contact_name")
  contactPhone           String               @map("contact_phone")
  contactEmail           String?              @map("contact_email")
  deliveryRecipientName  String               @map("delivery_recipient_name")
  deliveryRecipientPhone String               @map("delivery_recipient_phone")
  deliveryAddressLine1   String               @map("delivery_address_line1")
  deliveryAddressLine2   String?              @map("delivery_address_line2")
  deliveryArea           String?              @map("delivery_area")
  deliveryDistrict       String               @map("delivery_district")
  deliveryDivision       String               @map("delivery_division")
  deliveryPostalCode     String?              @map("delivery_postal_code")
  deliveryCountryCode    String               @default("BD") @map("delivery_country_code") @db.Char(2)
  shippingZoneId         String               @map("shipping_zone_id") @db.Uuid
  shippingZone           ShippingZone         @relation(fields: [shippingZoneId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveryFeePoisha      Int                  @map("delivery_fee_poisha")
  couponId               String?              @map("coupon_id") @db.Uuid
  coupon                 Coupon?              @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status                 OrderStatus          @default(pending)
  subtotalPoisha         Int                  @map("subtotal_poisha")
  discountPoisha         Int                  @default(0) @map("discount_poisha")
  taxPoisha              Int                  @default(0) @map("tax_poisha")
  totalPoisha            Int                  @map("total_poisha")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  returns                OrderReturn[]
  payments               Payment[]
  shipments              Shipment[]
  redemption             CouponRedemption?

  @@index([customerId])
  @@index([shippingZoneId])
  @@index([couponId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String            @map("order_id") @db.Uuid
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variantId       String            @map("variant_id") @db.Uuid
  variant         ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productName     String            @map("product_name")
  variantSku      String            @map("variant_sku")
  attributes      Json              @default("{}") @db.JsonB
  unitPricePoisha Int               @map("unit_price_poisha")
  quantity        Int
  lineTotalPoisha Int               @map("line_total_poisha")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  returnItems     OrderReturnItem[]

  @@unique([orderId, variantId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fromStatus       OrderStatus? @map("from_status")
  toStatus         OrderStatus  @map("to_status")
  changedByAdminId String?      @map("changed_by_admin_id") @db.Uuid
  changedByAdmin   AdminUser?   @relation("OrderStatusChanges", fields: [changedByAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  note             String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId, createdAt])
  @@index([changedByAdminId])
  @@map("order_status_history")
}

model OrderReturn {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String            @map("order_id") @db.Uuid
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status            OrderReturnStatus @default(requested)
  reason            String
  refundTotalPoisha Int               @default(0) @map("refund_total_poisha")
  approvedAt        DateTime?         @map("approved_at") @db.Timestamptz(6)
  receivedAt        DateTime?         @map("received_at") @db.Timestamptz(6)
  refundedAt        DateTime?         @map("refunded_at") @db.Timestamptz(6)
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items             OrderReturnItem[]

  @@index([orderId])
  @@index([status])
  @@map("order_returns")
}

model OrderReturnItem {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnId           String      @map("return_id") @db.Uuid
  return             OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderItemId        String      @map("order_item_id") @db.Uuid
  orderItem          OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantity           Int
  refundAmountPoisha Int         @map("refund_amount_poisha")
  reason             String?
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("order_return_items")
}
