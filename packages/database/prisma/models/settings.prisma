model StoreSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

model ProviderSecretReference {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String
  credentialName  String   @map("credential_name")
  secretReference String   @map("secret_reference")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, credentialName])
  @@map("provider_secret_references")
}
