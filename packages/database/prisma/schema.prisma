generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentLocale {
  bn
  en
}

enum CategoryStatus {
  active
  archived
}

enum BrandStatus {
  active
  archived
}

enum ProductStatus {
  draft
  active
  archived
}

enum VariantStatus {
  active
  archived
}

enum AttributeValueType {
  text
  number
  boolean
  select
}

enum MediaProvider {
  r2
}

enum ReservationStatus {
  active
  released
  committed
  expired
}

enum ReservationReferenceType {
  cart
  order
  manual
}

enum StockMovementType {
  initial
  adjustment
  reservation
  release
  deduction
  return
}

enum CustomerStatus {
  active
  blocked
}

enum OtpChannel {
  sms
  email
}

enum OtpPurpose {
  customer_login
  phone_verification
  email_verification
  password_reset
}

enum AdminUserStatus {
  active
  disabled
}

enum AdminRoleScope {
  store
  platform
}

model Category {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId             String?               @map("parent_id") @db.Uuid
  parent               Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children             Category[]            @relation("CategoryTree")
  imageMediaId         String?               @map("image_media_id") @db.Uuid
  imageMedia           MediaAsset?           @relation("CategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  status               CategoryStatus        @default(active)
  sortOrder            Int                   @default(0) @map("sort_order")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations         CategoryTranslation[]
  products             Product[]
  attributeDefinitions AttributeDefinition[]

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model CategoryTranslation {
  categoryId      String        @map("category_id") @db.Uuid
  locale          ContentLocale
  name            String
  slug            String
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

model Brand {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageMediaId String?            @map("image_media_id") @db.Uuid
  imageMedia   MediaAsset?        @relation("BrandImage", fields: [imageMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  status       BrandStatus        @default(active)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations BrandTranslation[]
  products     Product[]

  @@index([status])
  @@map("brands")
}

model BrandTranslation {
  brandId         String        @map("brand_id") @db.Uuid
  locale          ContentLocale
  name            String
  slug            String
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  brand           Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([brandId, locale])
  @@unique([locale, slug])
  @@map("brand_translations")
}

model Product {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String               @map("category_id") @db.Uuid
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brandId      String?              @map("brand_id") @db.Uuid
  brand        Brand?               @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status       ProductStatus        @default(draft)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations ProductTranslation[]
  variants     ProductVariant[]
  media        ProductMedia[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductTranslation {
  productId        String        @map("product_id") @db.Uuid
  locale           ContentLocale
  name             String
  slug             String
  shortDescription String?       @map("short_description")
  description      String?
  metaTitle        String?       @map("meta_title")
  metaDescription  String?       @map("meta_description")
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([productId, locale])
  @@unique([locale, slug])
  @@map("product_translations")
}

model AttributeDefinition {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String             @map("category_id") @db.Uuid
  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attributeKey String             @map("attribute_key")
  valueType    AttributeValueType @map("value_type")
  isRequired   Boolean            @default(false) @map("is_required")
  isFilterable Boolean            @default(false) @map("is_filterable")
  options      String[]           @default([])
  sortOrder    Int                @default(0) @map("sort_order")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([categoryId, attributeKey])
  @@map("attribute_definitions")
}

model ProductVariant {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId            String         @map("product_id") @db.Uuid
  product              Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sku                  String         @unique
  pricePoisha          Int            @map("price_poisha")
  compareAtPricePoisha Int?           @map("compare_at_price_poisha")
  attributes           Json           @default("{}") @db.JsonB
  status               VariantStatus  @default(active)
  sortOrder            Int            @default(0) @map("sort_order")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  inventoryItem        InventoryItem?

  @@index([productId])
  @@map("product_variants")
}

model MediaAsset {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider       MediaProvider  @default(r2)
  storageKey     String         @map("storage_key")
  mimeType       String         @map("mime_type")
  sizeBytes      BigInt         @map("size_bytes")
  width          Int?
  height         Int?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  altTexts       MediaAltText[]
  productMedia   ProductMedia[]
  categoryImages Category[]     @relation("CategoryImage")
  brandImages    Brand[]        @relation("BrandImage")

  @@unique([provider, storageKey])
  @@map("media_assets")
}

model MediaAltText {
  mediaId String        @map("media_id") @db.Uuid
  locale  ContentLocale
  altText String        @map("alt_text")
  media   MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([mediaId, locale])
  @@map("media_alt_texts")
}

model ProductMedia {
  productId String     @map("product_id") @db.Uuid
  mediaId   String     @map("media_id") @db.Uuid
  sortOrder Int        @default(0) @map("sort_order")
  isPrimary Boolean    @default(false) @map("is_primary")
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([productId, mediaId])
  @@index([mediaId])
  @@map("product_media")
}

model InventoryItem {
  variantId         String             @id @map("variant_id") @db.Uuid
  variant           ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantityOnHand    Int                @default(0) @map("quantity_on_hand")
  quantityReserved  Int                @default(0) @map("quantity_reserved")
  lowStockThreshold Int                @default(0) @map("low_stock_threshold")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  reservations      StockReservation[]
  movements         StockMovement[]

  @@map("inventory_items")
}

model StockReservation {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId     String                    @map("variant_id") @db.Uuid
  inventoryItem InventoryItem             @relation(fields: [variantId], references: [variantId], onDelete: Restrict, onUpdate: Cascade)
  quantity      Int
  status        ReservationStatus         @default(active)
  referenceType ReservationReferenceType? @map("reference_type")
  referenceId   String?                   @map("reference_id") @db.Uuid
  expiresAt     DateTime?                 @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([variantId])
  @@index([status, expiresAt])
  @@index([referenceType, referenceId])
  @@map("stock_reservations")
}

model StockMovement {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId         String                    @map("variant_id") @db.Uuid
  inventoryItem     InventoryItem             @relation(fields: [variantId], references: [variantId], onDelete: Restrict, onUpdate: Cascade)
  type              StockMovementType
  onHandDelta       Int                       @map("on_hand_delta")
  reservedDelta     Int                       @map("reserved_delta")
  resultingOnHand   Int                       @map("resulting_on_hand")
  resultingReserved Int                       @map("resulting_reserved")
  referenceType     ReservationReferenceType? @map("reference_type")
  referenceId       String?                   @map("reference_id") @db.Uuid
  note              String?
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Customer {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone           String?           @unique
  email           String?           @unique
  passwordHash    String?           @map("password_hash")
  firstName       String?           @map("first_name")
  lastName        String?           @map("last_name")
  status          CustomerStatus    @default(active)
  emailVerifiedAt DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?         @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  addresses       CustomerAddress[]

  @@index([status])
  @@map("customers")
}

model CustomerAddress {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  label             String?
  recipientName     String   @map("recipient_name")
  recipientPhone    String   @map("recipient_phone")
  addressLine1      String   @map("address_line1")
  addressLine2      String?  @map("address_line2")
  area              String?
  district          String
  division          String
  postalCode        String?  @map("postal_code")
  countryCode       String   @default("BD") @map("country_code") @db.Char(2)
  isDefaultShipping Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean  @default(false) @map("is_default_billing")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerId])
  @@map("customer_addresses")
}

model OtpCode {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel       OtpChannel
  purpose       OtpPurpose
  destination   String
  codeHash      String     @map("code_hash")
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime?  @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt DateTime?  @map("invalidated_at") @db.Timestamptz(6)
  attempts      Int        @default(0)
  maxAttempts   Int        @default(5) @map("max_attempts")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([destination, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

model AdminRole {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String                @unique
  name        String
  description String?
  scope       AdminRoleScope        @default(store)
  isSystem    Boolean               @default(false) @map("is_system")
  sortOrder   Int                   @default(0) @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       AdminUser[]
  permissions AdminRolePermission[]

  @@index([scope])
  @@map("admin_roles")
}

model AdminPermission {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String                @unique
  description String?
  groupKey    String                @map("group_key")
  sortOrder   Int                   @default(0) @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("admin_role_permissions")
}

model AdminUser {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String          @map("role_id") @db.Uuid
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  email        String          @unique
  passwordHash String          @map("password_hash")
  displayName  String          @map("display_name")
  status       AdminUserStatus @default(active)
  lastLoginAt  DateTime?       @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([roleId])
  @@index([status])
  @@map("admin_users")
}
